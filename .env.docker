# ====================== Основные настройки ======================
APP_NAME=FastAPI Cost-Calculator
DEBUG=True
ENV=docker

# ====================== PostgreSQL ======================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secret
POSTGRES_DB=foodcost_db

# Полная строка подключения (используется SQLAlchemy)
DATABASE_URL=postgresql+asyncpg://postgres:postgres_secret@db:5432/foodcost_db

# ====================== Redis ======================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redispass
REDIS_DB=0
CACHE_EXPIRE_SECONDS=300

# ====================== FastAPI ======================
FASTAPI_PORT=8000

# ====================== Security ======================
SECRET_KEY=cclhIbhaoRMEvNRZAwoOZ1iuFqMbZT5DLNS2qCZHNIh
REFRESH_SECRET_KEY=rjE2R8u4EvukTNycDiijzzlBt2ytQYvlcrP8ZFffJEj
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE=120
REFRESH_TOKEN_EXPIRE_DAYS=30

# ====================== CORS ======================
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:8000,http://127.0.0.1:5173,192.168.100.2:5173,https://nocapkenny.github.io/

# ====================== Paths ======================
STATIC_DIR=static
IMAGES_DIR=static/images
UPLOAD_DIR=uploads
TIMEZONE=Europe/Moscow

# ====================== Logging ======================
LOG_LEVEL=20